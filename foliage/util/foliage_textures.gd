class_name FoliageTextures
extends RefCounted

## Builds the noise and palette textures the foliage shaders sample.
##
## Generated in code rather than shipped as image files, for two reasons: the
## wind noise MUST tile seamlessly (a visible seam in the wind field reads as a
## crease sweeping across the whole landscape, which is far more obvious than a
## seam in a colour map), and a palette is easier to review and version as a
## list of colours than as a PNG nobody can diff.
##
## Both are cached by key, because a location swap should not rebuild textures
## that several locations share.

static var _cache: Dictionary = {}


## Seamless tiling greyscale noise.
##
## `seamless` is the load-bearing flag. Godot generates seamless noise by
## blending the image against itself, which is slower to bake and slightly
## softer than raw noise -- both acceptable, neither optional here.
static func noise_texture(seed: int, frequency: float, size: int = 512, octaves: int = 4) -> NoiseTexture2D:
	var key := "noise:%d:%f:%d:%d" % [seed, frequency, size, octaves]
	if _cache.has(key):
		return _cache[key]

	var noise := FastNoiseLite.new()
	# TYPE_VALUE_CUBIC matches the shape language the PlacesOS spike used for
	# its terrain: soft, rounded, no ridged simplex sharpness.
	noise.noise_type = FastNoiseLite.TYPE_VALUE_CUBIC
	noise.seed = seed
	noise.frequency = frequency
	noise.fractal_octaves = octaves
	noise.fractal_lacunarity = 2.0
	noise.fractal_gain = 0.5

	var texture := NoiseTexture2D.new()
	texture.noise = noise
	texture.width = size
	texture.height = size
	texture.seamless = true
	texture.generate_mipmaps = true
	# Not normalised: normalising rescales each bake to its own min/max, so two
	# textures built from the same settings at different sizes would not match.
	texture.normalize = true

	_cache[key] = texture
	return texture


## A palette as a 1D gradient texture, dark/shadowed at 0 and light/sun-bleached
## at 1. The shader maps noise through this, so the gradient IS the location's
## colour identity -- see FoliageProfile.
static func palette_texture(colours: PackedColorArray, name: String = "") -> GradientTexture1D:
	var key := "palette:%s:%s" % [name, str(colours)]
	if _cache.has(key):
		return _cache[key]

	var gradient := Gradient.new()
	gradient.interpolation_mode = Gradient.GRADIENT_INTERPOLATE_LINEAR
	# Gradient starts with two stops; clear by overwriting offset 0 and 1 then
	# adding the rest, since Gradient has no "remove all" call.
	gradient.set_offset(0, 0.0)
	gradient.set_color(0, colours[0])
	gradient.set_offset(1, 1.0)
	gradient.set_color(1, colours[colours.size() - 1])
	for i in range(1, colours.size() - 1):
		gradient.add_point(float(i) / float(colours.size() - 1), colours[i])

	var texture := GradientTexture1D.new()
	texture.gradient = gradient
	texture.width = 256
	texture.use_hdr = false

	_cache[key] = texture
	return texture


## The reference palettes live on FoliageProfile, not here -- GDScript cannot
## resolve an external class constant as an @export default, so they have to sit
## in the class whose exports use them.


## The clump sprite atlas, regenerated by tools/blender/make_grass_sprites.py.
## Kept behind a function so a missing file fails loudly at one place rather
## than leaving every grass material silently sampling the default white texture
## -- which renders as a field of solid squares and is oddly hard to diagnose.
static func sprite_atlas() -> Texture2D:
	const PATH := "res://assets/foliage/legacy/grass_sprites.png"
	if _cache.has(PATH):
		return _cache[PATH]
	if not ResourceLoader.exists(PATH):
		push_error("Grass sprite atlas missing at %s -- run tools/blender/make_grass_sprites.py" % PATH)
		return null
	var texture: Texture2D = load(PATH)
	_cache[PATH] = texture
	return texture


